if.....else......elif
# 1. Grading system
marks = 78
if marks >= 80:
    print("A grade")
elif marks >= 70:
    print("B grade")
elif marks >= 60:
    print("C grade")
else:
    print("Fail")

# 2. Positive, negative, or zero
n = 0
if n > 0:
    print("Positive")
elif n < 0:
    print("Negative")
else:
    print("Zero")

# 3. Traffic light
light = "yellow"
if light == "green":
    print("Go")
elif light == "yellow":
    print("Slow down")
else:
    print("Stop")

# 4. BMI category
bmi = 22.5
if bmi < 18.5:
    print("Underweight")
elif bmi < 25:
    print("Normal")
elif bmi < 30:
    print("Overweight")
else:
    print("Obese")

# 5. Day type
day = "Sunday"
if day == "Saturday":
    print("Weekend")
elif day == "Sunday":
    print("Weekend")
else:
    print("Weekday")
